# ===== Server =====
PORT=3001

# ===== Supabase =====
# Để trống để dùng local JSON (dev). Đặt STORAGE_DRIVER=supabase khi deploy.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_DRIVER=local

# Khóa mã hoá API key của người dùng (AES-256-GCM).
# Tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# ===== AI mặc định =====
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_MODEL=google/gemini-2.5-flash

# ===== CORS / URL =====
# Khi frontend và backend cùng domain, có thể để trống.
CORS_ORIGIN=
APP_URL=http://localhost:5173
